<?xml version="1.0" encoding="utf-8"?>
<!-- Playback CDNs often redirect HTTPS playUrl → plain HTTP (IP host).
     Domain allowlists do not cover those redirect targets, so cleartext
     must be permitted for media to load on Android 9+.
     To force HTTPS for your own backend, add a <domain-config> with
     cleartextTrafficPermitted="false" for its domain. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
