// ─────────────────────────────────────────────────────────────────────
// APP IDENTITY — the ONE place to rename the app or change its ID.
//
// After changing anything here: `flutter clean`, then rebuild.
// (iOS also: `cd apps/mobile/ios && pod install`.)
//
//   APP_NAME   Launcher / home-screen name (Android phone + TV, iPhone)
//              and in-app text (Dart reads it at startup -> AppBrand.name).
//   APP_ID     Android applicationId (phone + TV) and iOS bundle identifier.
//              Lower-case, dots, no spaces. Changing it = a different app
//              on the device (old installs are not updated).
//   APP_DEVELOPMENT_TEAM
//              Apple Developer Team ID for iOS signing (empty = pick it
//              in Xcode > Runner > Signing & Capabilities).
//
// Format: xcconfig (KEY = value). One key per line, no quotes.
// ─────────────────────────────────────────────────────────────────────
APP_NAME = XPlayer
APP_ID = com.xplayer.app
APP_DEVELOPMENT_TEAM =
